# HH_260414: Reduce message filter queue depth to mitigate TF extrapolation flicker/crashes in real-sensor runs.
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Map1/Lanelet2_Map1/Namespaces1
        - /Map1/Inflation_Cost_Marker1/Namespaces1
        - /Localization1/Pose1
        - /Sensing1
        - /Perception1
        - /Planning1
      Splitter Ratio: 0.5904255509376526
    Tree Height: 785
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.380952388048172
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: tier4_adapi_rviz_plugins::RoutePanel
    Name: Route Panel
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    # HH_260413: Keep sync source on always-visible map display to avoid RViz close when
    # toggling Localization group displays.
    SyncSource: Lanelet2_Map
Visualization Manager:
  Class: ""
  Displays:
