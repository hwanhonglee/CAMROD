<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camrod_control</name>
  <version>0.1.0</version>
  <description>Motion maneuvers and supervised velocity control for CAMROD.</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <license>Apache-2.0</license>

  <!-- HH_260721 - Build the flattened native C++ control runtime. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <!-- HH_260721 - Launch files resolve package shares through ament index at runtime. -->
  <exec_depend>ament_index_python</exec_depend>
  <depend>avg_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <!-- HH_260721 - Consume normalized Ranger BMS state through AvgPlatformStatus only. -->
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <!-- HH_260721 - Parse station and optional yaw-alignment configuration natively. -->
  <depend>yaml-cpp</depend>
  <!-- HH_260720 - AprilTag parking conditionally launches its perception detector. -->
  <exec_depend>camrod_perception</exec_depend>
  <!-- HH_260807 - Standalone maneuver/parking launches resolve active semantic maps. -->
  <exec_depend>camrod_map</exec_depend>
  <exec_depend>camrod_planning</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- HH_260721 - Exercise native control policies without a running ROS graph. -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
