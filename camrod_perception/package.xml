<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camrod_perception</name>
  <version>0.0.0</version>
  <!-- HH_260617: Replace placeholder metadata with the package role. -->
  <description>Perception nodes and configuration for obstacle, camera, and detection processing.</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <!-- HH_260114 Set explicit Apache license. -->
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <!-- HH_260805 - Compose rear-camera parking perception without changing its standalone CLI. -->
  <depend>rclcpp_components</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>image_geometry</depend>
  <depend>visualization_msgs</depend>
  <depend>rclpy</depend>
  <depend>avg_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- HH_260720 - Keep detector and cv_bridge on one OpenCV ABI. -->
  <depend>opencv4_vendor</depend>
  <depend>message_filters</depend>
  <depend>OpenCV</depend>
  <depend>eigen</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>std_msgs</depend>
  <!-- HH_260720 - Rear-camera parking-tag detection uses the system AprilTag C library. -->
  <depend>apriltag</depend>
  <depend>yaml-cpp</depend>
  <!-- HH_260720 - Preserve the original external rectification pipeline. -->
  <exec_depend>image_proc</exec_depend>

  <!-- HJ_260529: optional YOLO packages — declared so packages-up-to pulls them in automatically -->
  <exec_depend>yolov9mit</exec_depend>
  <exec_depend>yolov9mit_ros</exec_depend>
  <!-- HH_260807 - Standalone campsite occupancy resolves active site semantics. -->
  <exec_depend>camrod_planning</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
