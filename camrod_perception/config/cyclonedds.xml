<CycloneDDS>
  <!-- HH_260521 - Bind camera DDS transport to loopback and disable shared memory for this profile. -->
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="false"/>
      </Interfaces>
    </General>
    <Tracing>
      <Verbosity>severe</Verbosity>
    </Tracing>
    <SharedMemory>
      <Enable>false</Enable>
    </SharedMemory>
    <Internal>
      <!-- HH_260521 - A 1920x1080 BGR8 frame is about 6.2 MB; require net.core.rmem_max >= 20971520. -->
      <SocketReceiveBufferSize min="20971520B"/>
      <SocketSendBufferSize min="20971520B"/>
    </Internal>
  </Domain>
</CycloneDDS>
