<?xml version="1.0"?>
<package format="3">
  <name>camrod_system</name>
  <version>0.0.0</version>
  <description>System checker and diagnostics tools for CAMROD bringup.</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- HH_260326: integrated diagnostics nodes now build directly in camrod_system. -->
  <depend>avg_msgs</depend>
  <depend>rclcpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>unique_identifier_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
