<!--
  CAMROD docking behavior tree.
  Triggered by the state machine when battery is low or manual dock request.
  Uses DockRobot / UndockRobot action nodes from opennav_docking_bt.

  dock_id must match an entry in camrod_docking/config/docks.yaml.
  dock_type must match a key in docking_server.yaml dock_plugins list.
-->
<root main_tree_to_execute="DockRobot">

  <BehaviorTree ID="DockRobot">
    <DockRobot dock_id="home_dock" dock_type="apriltag_dock"/>
  </BehaviorTree>

  <BehaviorTree ID="UndockRobot">
    <UndockRobot dock_type="apriltag_dock"/>
  </BehaviorTree>

</root>
