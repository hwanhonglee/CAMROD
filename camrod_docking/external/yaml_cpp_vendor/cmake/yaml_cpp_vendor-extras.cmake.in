set(_yaml_cpp_install "${yaml_cpp_vendor_DIR}/../../../opt/yaml_cpp_vendor")

if(NOT TARGET yaml-cpp)
  add_library(yaml-cpp SHARED IMPORTED GLOBAL)
  set_target_properties(yaml-cpp PROPERTIES
    IMPORTED_LOCATION "${_yaml_cpp_install}/lib/libyaml-cpp.so"
    INTERFACE_INCLUDE_DIRECTORIES "${_yaml_cpp_install}/include"
  )
endif()

if(NOT TARGET yaml-cpp::yaml-cpp)
  add_library(yaml-cpp::yaml-cpp ALIAS yaml-cpp)
endif()

set(YAML_CPP_LIBRARIES yaml-cpp)
set(YAML_CPP_INCLUDE_DIR "${_yaml_cpp_install}/include")
set(yaml_cpp_vendor_LIBRARIES yaml-cpp)
set(yaml_cpp_vendor_INCLUDE_DIRS "${_yaml_cpp_install}/include")
list(APPEND yaml_cpp_vendor_TARGETS yaml-cpp)

# Embed vendored lib path as RPATH in all downstream binaries.
list(APPEND CMAKE_INSTALL_RPATH "${_yaml_cpp_install}/lib")
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
