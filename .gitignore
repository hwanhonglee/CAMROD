# Colcon build artifacts at repository root.
/build/
/install/
/log/

# HH_260528: Nested third-party package build artifacts.
build/

# Python cache artifacts.
__pycache__/
*.pyc

# environment param / key 
.env
.env.local
*.pem
*.key

# ROS 2 bag file (large storage - MB ~ GB)
*.bag
*.db3
*.db3.zstd
*.mcap

# virtual env
.venv/
venv/
env/

# package/test cache
*.egg-info/
.pytest_cache/
.coverage
.mypy_cache/

# colcon cache
.colcon/

# OS
.DS_Store        # macOS
Thumbs.db        # Windows

# IDE
.vscode/
.idea/
*.swp            # vim
*.Identifier     # Xcode / macOS identifier files
# Windows WSL alternate data stream artifacts (*:Zone.Identifier, *:Zone.Identifier:Zone.Identifier)
**/*:Zone.Identifier
**/*:Zone.Identifier:Zone.Identifier

# HH_260428: SDK installer binaries — download via setup scripts, not stored in git.
# ZED SDK: https://www.stereolabs.com/developers/release
# Orbbec SDK: https://github.com/orbbec/OrbbecSDK/releases
disable/vio_bridge/sdk_installers/*.run
disable/vio_bridge/sdk_installers/*.deb

# Node.js / frontend build artifacts
node_modules/
# HH_260721 - The active UI tree is camrod_ui_robot/assets/frontend; retire legacy runtime paths.
