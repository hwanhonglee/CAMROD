<?xml version="1.0"?>
<robot name="camrod_sensor_kit" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- 1. Base link / sensor kit base link arguments             -->
  <!-- ========================================================= -->
  <xacro:arg name="base_link" default="robot_base_link"/>
  <xacro:arg name="sensor_kit_base_link" default="sensor_kit_base_link"/>

  <!-- ========================================================= -->
  <!-- 2. Simple robot body size (for visualization only)        -->
  <!-- ========================================================= -->
  <xacro:arg name="base_length" default="1.4"/>
  <xacro:arg name="base_width"  default="0.7"/>
  <xacro:arg name="base_height" default="1.2"/>

  <!-- ========================================================= -->
  <!-- 3. Existing sensor transform arguments                    -->
  <!--    xyz: meters                                            -->
  <!--    rpy: radians                                           -->
  <!-- ========================================================= -->
  <xacro:arg name="imu_xyz" default="0.1 0.0 0.4"/>
  <xacro:arg name="imu_rpy" default="0.0 0.0 0.0"/>

  <xacro:arg name="gnss_xyz" default="0.2 0.0 1.0"/>
  <xacro:arg name="gnss_rpy" default="0.0 0.0 0.0"/>

  <xacro:arg name="lidar_xyz" default="0.5 0.0 0.5"/>
  <xacro:arg name="lidar_rpy" default="0.0 0.0 0.0"/>

  <!-- HH_260326: Canonical camera frame arguments. -->
  <xacro:arg name="camera_xyz" default="0.35 0.0 0.8"/>
  <xacro:arg name="camera_rpy" default="0.0 0.0 0.0"/>

  <!-- HH_260326: Optional aggregate radar frame under sensor_kit_base_link. -->
  <xacro:arg name="radar_xyz" default="0.0 0.0 0.0"/>
  <xacro:arg name="radar_rpy" default="0.0 0.0 0.0"/>

  <!-- ========================================================= -->
  <!-- 4. Radar transform arguments                              -->
  <!--    yaw examples:                                          -->
  <!--      front  =   0 deg =  0.0                              -->
  <!--      left1  =  90 deg =  1.570796                         -->
  <!--      left2  = 135 deg =  2.356194                         -->
  <!--      right1 = -90 deg = -1.570796                         -->
  <!--      right2 = -135deg = -2.356194                         -->
  <!--      rear   = 180 deg =  3.141593                         -->
  <!-- ========================================================= -->
  <xacro:arg name="radar_front_xyz"  default="0.55 0.0 0.45"/>
  <xacro:arg name="radar_front_rpy"  default="0.0 0.0 0.0"/>

  <xacro:arg name="radar_left1_xyz"  default="0.20 0.45 0.45"/>
  <xacro:arg name="radar_left1_rpy"  default="0.0 0.0 1.570796"/>

  <xacro:arg name="radar_left2_xyz"  default="-0.20 0.45 0.45"/>
  <xacro:arg name="radar_left2_rpy"  default="0.0 0.0 2.356194"/>

  <xacro:arg name="radar_right1_xyz" default="0.20 -0.45 0.45"/>
  <xacro:arg name="radar_right1_rpy" default="0.0 0.0 -1.570796"/>

  <xacro:arg name="radar_right2_xyz" default="-0.20 -0.45 0.45"/>
  <xacro:arg name="radar_right2_rpy" default="0.0 0.0 -2.356194"/>

  <xacro:arg name="radar_rear_xyz"   default="-0.55 0.0 0.45"/>
  <xacro:arg name="radar_rear_rpy"   default="0.0 0.0 3.141593"/>

  <!-- ========================================================= -->
  <!-- 5. Local properties                                       -->
  <!-- ========================================================= -->
  <xacro:property name="base_link_name" value="$(arg base_link)"/>
  <xacro:property name="sensor_kit_base_link_name" value="$(arg sensor_kit_base_link)"/>
  <xacro:property name="base_length_val" value="$(arg base_length)"/>
  <xacro:property name="base_width_val"  value="$(arg base_width)"/>
  <xacro:property name="base_height_val" value="$(arg base_height)"/>

  <!-- ========================================================= -->
  <!-- 6. Reusable sensor macro                                  -->
  <!--    Creates one link + one fixed joint                     -->
  <!-- ========================================================= -->
  <xacro:macro name="sensor_link" params="name parent xyz rpy color_rgba radius length mass">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${color_rgba}"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
                 iyy="1e-4" iyz="0.0"
                 izz="1e-4"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ========================================================= -->
  <!-- 7. Robot base link                                        -->
  <!-- ========================================================= -->
  <link name="${base_link_name}">
    <visual>
      <origin xyz="0 0 ${base_height_val / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length_val} ${base_width_val} ${base_height_val}"/>
      </geometry>
      <material name="body_color">
        <color rgba="0.10 0.60 0.90 0.20"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_height_val / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length_val} ${base_width_val} ${base_height_val}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 ${base_height_val / 2.0}" rpy="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0"
               izz="1.0"/>
    </inertial>
  </link>

  <!-- ========================================================= -->
  <!-- 8. Sensor kit base link                                   -->
  <!-- ========================================================= -->
  <link name="${sensor_kit_base_link_name}"/>

  <joint name="${base_link_name}_to_${sensor_kit_base_link_name}" type="fixed">
    <parent link="${base_link_name}"/>
    <child link="${sensor_kit_base_link_name}"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- 9. Existing sensors                                       -->
  <!-- ========================================================= -->
  <xacro:sensor_link
    name="imu_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg imu_xyz)"
    rpy="$(arg imu_rpy)"
    color_rgba="1.0 0.8 0.2 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="gnss_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg gnss_xyz)"
    rpy="$(arg gnss_rpy)"
    color_rgba="0.6 0.9 0.4 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="lidar_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg lidar_xyz)"
    rpy="$(arg lidar_rpy)"
    color_rgba="0.9 0.3 0.3 1.0"
    radius="0.05"
    length="0.10"
    mass="0.30"/>

  <xacro:sensor_link
    name="camera_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg camera_xyz)"
    rpy="$(arg camera_rpy)"
    color_rgba="0.4 0.8 1.0 1.0"
    radius="0.04"
    length="0.08"
    mass="0.15"/>

  <!-- ========================================================= -->
  <!-- 10. Radar sensors                                         -->
  <!-- ========================================================= -->
  <!-- HH_260326: Group radar sensors under radar_link frame. -->
  <link name="radar_link"/>
  <joint name="radar_link_joint" type="fixed">
    <parent link="${sensor_kit_base_link_name}"/>
    <child link="radar_link"/>
    <origin xyz="$(arg radar_xyz)" rpy="$(arg radar_rpy)"/>
  </joint>

  <xacro:sensor_link
    name="radar_front_link"
    parent="radar_link"
    xyz="$(arg radar_front_xyz)"
    rpy="$(arg radar_front_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_left1_link"
    parent="radar_link"
    xyz="$(arg radar_left1_xyz)"
    rpy="$(arg radar_left1_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_left2_link"
    parent="radar_link"
    xyz="$(arg radar_left2_xyz)"
    rpy="$(arg radar_left2_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_right1_link"
    parent="radar_link"
    xyz="$(arg radar_right1_xyz)"
    rpy="$(arg radar_right1_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_right2_link"
    parent="radar_link"
    xyz="$(arg radar_right2_xyz)"
    rpy="$(arg radar_right2_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_rear_link"
    parent="radar_link"
    xyz="$(arg radar_rear_xyz)"
    rpy="$(arg radar_rear_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

</robot>
