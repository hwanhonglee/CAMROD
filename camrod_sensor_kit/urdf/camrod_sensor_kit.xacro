<?xml version="1.0"?>
<robot name="camrod_sensor_kit" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- 1. Base link / sensor kit base link arguments             -->
  <!-- ========================================================= -->
  <xacro:arg name="robot_center_link" default="robot_center_link"/>
  <xacro:arg name="robot_base_link" default="robot_base_link"/>
  <xacro:arg name="sensor_kit_base_link" default="sensor_kit_base_link"/>
  <xacro:arg name="rear_axle_offset_x" default="0.443"/>

  <!-- ========================================================= -->
  <!-- 2. Simple robot body size (for visualization only)        -->
  <!-- ========================================================= -->
  <xacro:arg name="base_length" default="1.4"/>
  <xacro:arg name="base_width"  default="0.7"/>
  <xacro:arg name="base_height" default="1.2"/>
  <!-- HH_260803 - Body center is 0.01257 m ahead of the axle midpoint. -->
  <xacro:arg name="base_origin_xyz" default="0.012570 0.000050 0.394565"/>

  <!-- ========================================================= -->
  <!-- 3. Existing sensor transform arguments                    -->
  <!--    xyz: meters                                            -->
  <!--    rpy: radians                                           -->
  <!-- ========================================================= -->
  <xacro:arg name="imu_xyz" default="0.688 0.0 0.756"/>
  <xacro:arg name="imu_rpy" default="0.0 0.0 0.0"/>

  <!-- HH_260805 - Missing YAML keeps the unverified GNSS solution at robot center. -->
  <!-- HH_260806 - Left GNSS antenna is 0.45 m along robot body +Y. -->
  <xacro:arg name="gnss_xyz" default="0.0 0.45 0.0"/>
  <xacro:arg name="gnss_rpy" default="0.0 0.0 0.0"/>

  <xacro:arg name="lidar_xyz" default="0.76336 0.0 0.59538"/>
  <xacro:arg name="lidar_rpy" default="0.0 0.0 0.0"/>

  <!-- HH_260528: Dual econ camera arguments (front + rear).                    -->
  <!--   TF: sensor_kit_base_link → camera_front_link → camera_front (optical) -->
  <!--       sensor_kit_base_link → camera_rear_link  → camera_rear  (optical) -->
  <!-- HH_260803 - Fallbacks are robot_center_link-relative; mounts did not move. -->
  <!--   front: x=0.76337 m, z=0.49568 m, yaw=0 (forward-facing)              -->
  <!--   rear : x=-0.61933 m, z=0.30013 m, yaw=π (backward-facing)            -->
  <xacro:arg name="camera_front_xyz" default="0.76337 0.0 0.49568"/>
  <xacro:arg name="camera_front_rpy" default="0.0 0.0 0.0"/>

  <xacro:arg name="camera_rear_xyz"  default="-0.61933 0.0 0.30013"/>
  <xacro:arg name="camera_rear_rpy"  default="0.0 0.0 3.141593"/>

  <!-- ========================================================= -->
  <!-- 4. Radar transform arguments                              -->
  <!--    yaw examples:                                          -->
  <!--      front1/front2 = 0 deg = 0.0                           -->
  <!--      left1/left2   =  90 deg =  1.570796                  -->
  <!--      right1/right2 = -90 deg = -1.570796                  -->
  <!--      rear   = 180 deg =  3.141593                         -->
  <!-- ========================================================= -->
  <!-- HH_260623 - Removed the old single-front radar frame; only front1/front2 exist. -->
  <!-- HH_260803 - Fallback defaults are expressed from robot_center_link. -->
  <xacro:arg name="radar_front1_xyz" default="0.62787 -0.11005 0.33378"/>
  <xacro:arg name="radar_front1_rpy" default="0.0 0.0 0.0"/>

  <xacro:arg name="radar_front2_xyz" default="0.62787 0.11005 0.33378"/>
  <xacro:arg name="radar_front2_rpy" default="0.0 0.0 0.0"/>

  <xacro:arg name="radar_left1_xyz"  default="0.29188 0.41005 0.29013"/>
  <xacro:arg name="radar_left1_rpy"  default="0.0 0.0 1.570796"/>

  <xacro:arg name="radar_left2_xyz"  default="-0.28334 0.41005 0.29013"/>
  <xacro:arg name="radar_left2_rpy"  default="0.0 0.0 1.570796"/>

  <xacro:arg name="radar_right1_xyz" default="0.29188 -0.41005 0.29013"/>
  <xacro:arg name="radar_right1_rpy" default="0.0 0.0 -1.570796"/>

  <xacro:arg name="radar_right2_xyz" default="-0.28334 -0.41005 0.29013"/>
  <xacro:arg name="radar_right2_rpy" default="0.0 0.0 -1.570796"/>

  <xacro:arg name="radar_rear_xyz"   default="-0.61733 0.0 0.33978"/>
  <xacro:arg name="radar_rear_rpy"   default="0.0 0.0 3.141593"/>

  <!-- ========================================================= -->
  <!-- 5. Local properties                                       -->
  <!-- ========================================================= -->
  <xacro:property name="center_link_name" value="$(arg robot_center_link)"/>
  <xacro:property name="rear_base_link_name" value="$(arg robot_base_link)"/>
  <xacro:property name="sensor_kit_base_link_name" value="$(arg sensor_kit_base_link)"/>
  <xacro:property name="rear_axle_offset_x_val" value="$(arg rear_axle_offset_x)"/>
  <xacro:property name="base_length_val" value="$(arg base_length)"/>
  <xacro:property name="base_width_val"  value="$(arg base_width)"/>
  <xacro:property name="base_height_val" value="$(arg base_height)"/>
  <xacro:property name="base_origin_xyz_val" value="$(arg base_origin_xyz)"/>

  <!-- ========================================================= -->
  <!-- 6. Reusable sensor macros                                 -->
  <!-- ========================================================= -->

  <!-- sensor_link: one body link + one fixed joint -->
  <xacro:macro name="sensor_link" params="name parent xyz rpy color_rgba radius length mass">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="${color_rgba}"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
                 iyy="1e-4" iyz="0.0"
                 izz="1e-4"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- HH_260528: econ_camera_link macro                                       -->
  <!--   Creates a body frame (name) and an optical child frame (optical_name).-->
  <!--   optical_name joint uses the standard ROS camera optical convention:  -->
  <!--     RPY = -π/2, 0, -π/2  (Z forward, Y down in optical frame)         -->
  <xacro:macro name="econ_camera_link" params="name optical_name parent xyz rpy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.10 0.04"/>
        </geometry>
        <material name="${name}_mat">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.10 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
                 iyy="1e-4" iyz="0.0"
                 izz="1e-4"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Optical frame: Z forward, Y down (standard ROS camera convention). -->
    <link name="${optical_name}"/>
    <joint name="${optical_name}_joint" type="fixed">
      <parent link="${name}"/>
      <child link="${optical_name}"/>
      <origin xyz="0 0 0" rpy="-1.570796 0.0 -1.570796"/>
    </joint>
  </xacro:macro>

  <!-- ========================================================= -->
  <!-- 7. Robot center and legacy rear-axle base links           -->
  <!-- ========================================================= -->
  <link name="${center_link_name}">
    <visual>
      <origin xyz="${base_origin_xyz_val}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length_val} ${base_width_val} ${base_height_val}"/>
      </geometry>
      <material name="body_color">
        <color rgba="0.10 0.60 0.90 0.20"/>
      </material>
    </visual>

    <collision>
      <origin xyz="${base_origin_xyz_val}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length_val} ${base_width_val} ${base_height_val}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10.0"/>
      <origin xyz="${base_origin_xyz_val}" rpy="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0"
               izz="1.0"/>
    </inertial>
  </link>

  <!-- HH_260803 - Keep robot_base_link as an explicit rear-axle compatibility frame. -->
  <link name="${rear_base_link_name}"/>
  <joint name="${center_link_name}_to_${rear_base_link_name}" type="fixed">
    <parent link="${center_link_name}"/>
    <child link="${rear_base_link_name}"/>
    <origin xyz="-${rear_axle_offset_x_val} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- 8. Sensor kit base link                                   -->
  <!-- ========================================================= -->
  <link name="${sensor_kit_base_link_name}"/>

  <joint name="${center_link_name}_to_${sensor_kit_base_link_name}" type="fixed">
    <parent link="${center_link_name}"/>
    <child link="${sensor_kit_base_link_name}"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- 9. Existing sensors                                       -->
  <!-- ========================================================= -->
  <xacro:sensor_link
    name="imu_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg imu_xyz)"
    rpy="$(arg imu_rpy)"
    color_rgba="1.0 0.8 0.2 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="gnss_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg gnss_xyz)"
    rpy="$(arg gnss_rpy)"
    color_rgba="0.6 0.9 0.4 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="lidar_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg lidar_xyz)"
    rpy="$(arg lidar_rpy)"
    color_rgba="0.9 0.3 0.3 1.0"
    radius="0.05"
    length="0.10"
    mass="0.30"/>

  <!-- HH_260623 - Removed old single camera_link; camera_front/camera_rear are canonical. -->

  <!-- ========================================================= -->
  <!-- 10. Radar sensors                                         -->
  <!-- ========================================================= -->
  <!-- HH_260507: Radar sensors are attached directly under sensor_kit_base_link. -->
  <!-- HH_260623 - Front radar TFs match the 7-channel radar topics exactly. -->

  <xacro:sensor_link
    name="radar_front1_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_front1_xyz)"
    rpy="$(arg radar_front1_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_front2_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_front2_xyz)"
    rpy="$(arg radar_front2_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_left1_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_left1_xyz)"
    rpy="$(arg radar_left1_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_left2_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_left2_xyz)"
    rpy="$(arg radar_left2_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_right1_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_right1_xyz)"
    rpy="$(arg radar_right1_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_right2_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_right2_xyz)"
    rpy="$(arg radar_right2_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <xacro:sensor_link
    name="radar_rear_link"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg radar_rear_xyz)"
    rpy="$(arg radar_rear_rpy)"
    color_rgba="0.95 0.65 0.20 1.0"
    radius="0.03"
    length="0.06"
    mass="0.10"/>

  <!-- ========================================================= -->
  <!-- 11. Econ dual cameras (HH_260528)                         -->
  <!--     sensor_kit_base_link → camera_front_link → camera_front -->
  <!--     sensor_kit_base_link → camera_rear_link  → camera_rear  -->
  <!-- ========================================================= -->
  <xacro:econ_camera_link
    name="camera_front_link"
    optical_name="camera_front"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg camera_front_xyz)"
    rpy="$(arg camera_front_rpy)"/>

  <xacro:econ_camera_link
    name="camera_rear_link"
    optical_name="camera_rear"
    parent="${sensor_kit_base_link_name}"
    xyz="$(arg camera_rear_xyz)"
    rpy="$(arg camera_rear_rpy)"/>

</robot>
