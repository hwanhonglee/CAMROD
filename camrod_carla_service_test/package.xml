<?xml version="1.0"?>
<!-- HH_261103 - Isolate simulator docking compatibility from unit1/unit2 control packages. -->
<package format="3">
  <name>camrod_carla_service_test</name>
  <version>0.1.0</version>
  <description>Explicit CARLA-only service usability docking compatibility and test composition.</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>avg_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>camrod_carla_adapter</exec_depend>
  <exec_depend>camrod_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>camrod_sensor_kit</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
