<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camrod_bringup</name>
  <version>0.0.0</version>
  <!-- HH_260617: Replace placeholder metadata with the package role. -->
  <description>Launch orchestration and system-level configuration profiles for the CAMROD stack.</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <!-- Set explicit Apache license. -->
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ros2launch</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- HH_260721 - Fake hardware publishes Ranger/BMS driver-boundary messages in simulation. -->
  <depend>ranger_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <!-- HH_260730 - avg_msgs plus geometry/nav/sensor messages are also the
       eight-stage production contract measured by pose_latency_probe.py. -->
  <depend>avg_msgs</depend>
  <!-- HH_260707: Optional front-camera/YOLO component container launch path. -->
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- HH_260805 - Full bringup owns the CycloneDDS/iceoryx transport profile
       and starts RouDi before ROS component containers. -->
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>iceoryx_posh</exec_depend>
  <!-- HH_260730 - field_test_tool.sh record-recovery invokes ros2 bag directly. -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <!-- HH_260730 / TODOLIST 2 - Field probe decodes NvJPEG output independently. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- Launch-time dependencies for fused localization and sensing pipeline. -->
  <exec_depend>camrod_sensor_kit</exec_depend>
  <exec_depend>camrod_localization</exec_depend>
  <exec_depend>camrod_map</exec_depend>
  <exec_depend>camrod_perception</exec_depend>
  <exec_depend>camrod_planning</exec_depend>
  <!-- HH_260720 - Bringup launches the extracted control and selected parking modules. -->
  <exec_depend>camrod_control</exec_depend>
  <exec_depend>camrod_sensing</exec_depend>
  <exec_depend>camrod_platform</exec_depend>
  <exec_depend>camrod_system</exec_depend>
  <exec_depend>camrod_ui</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- HH_260722 - Test GNSS launch-default and configuration-mirror synchronization. -->
  <test_depend>ament_cmake_pytest</test_depend>
  <!-- HH_260729 - Radar/GNSS default synchronization tests parse YAML. -->
  <test_depend>python3-yaml</test_depend>
  <!-- HH_260804 - Rebuild and inspect package-level PNG/GIF documentation. -->
  <test_depend>python3-matplotlib</test_depend>
  <test_depend>python3-pil</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
