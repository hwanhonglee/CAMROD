<!-- PlannerSelector-enabled BT.
  - Default planner: LaneletRoute
  - Optional planners: Smac2D, NavFn, SmacHybrid, SmacLattice
  - Default controller: RPP
  - Optional controllers: MPPI, DWB, Graceful, RotationShim
  - Switch planner by publishing std_msgs/String to /planning/planner_selector
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateGoalLocked">
        <!-- PlannerSelector sets {selected_planner} on the blackboard -->
        <!-- HH_260626 - Default to connected lanelet routing; grid planners
             remain fallback/selectable for recovery and debugging. -->
        <PlannerSelector selected_planner="{selected_planner}" default_planner="LaneletRoute" topic_name="/planning/planner_selector"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="RPP" topic_name="/planning/controller_selector"/>
        <!-- HH_260619 - Lock the global route after each accepted goal.
             GoalUpdatedController computes a new global path only on the first
             tick, goal preemption, or recovery restart. The local path extractor
             then slices the fixed global route around the live robot pose. -->
        <GoalUpdatedController>
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <!-- HH_260626 - Try connected/selected route first, then grid fallbacks. -->
            <Fallback name="ComputePathPlannerFallback">
              <!-- HH_260619 - Pass the navigator-provided snapped start pose.
                   Without start="{start}", ComputePathToPose silently plans from
                   current TF and draws a short off-center connector near the robot. -->
              <ComputePathToPose goal="{goal}" start="{start}" path="{path}" planner_id="{selected_planner}"/>
              <!-- HH_260702 - Prefer curvature-aware fallback before 2D grid fallback. -->
              <ComputePathToPose goal="{goal}" start="{start}" path="{path}" planner_id="SmacLattice"/>
              <ComputePathToPose goal="{goal}" start="{start}" path="{path}" planner_id="Smac2D"/>
              <ComputePathToPose goal="{goal}" start="{start}" path="{path}" planner_id="NavFn"/>
            </Fallback>
            <Sequence name="ClearGlobalCostmapAndSettle-Context">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              <!-- HH_260528 - Costmap clear->replan race guard.
                   Give global layers one short cycle to repopulate before retrying ComputePath. -->
              <Wait wait_duration="0.4"/>
            </Sequence>
          </RecoveryNode>
        </GoalUpdatedController>
        <!-- HH_260630 - Smooth every planner result before FollowPath. Collision
             checking is disabled here because long LaneletRoute paths can extend
             outside the rolling/global costmap window and falsely abort smoothing. -->
        <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="SimpleSmoother" check_for_collisions="false"/>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <!-- HH_260528 - Let clear services settle before the next recovery branch/planner retry. -->
            <Wait wait_duration="0.4"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
