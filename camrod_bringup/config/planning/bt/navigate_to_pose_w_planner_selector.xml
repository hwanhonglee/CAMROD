<!-- PlannerSelector-enabled BT.
  - Default planner: Smac2D
  - Switch planner by publishing std_msgs/String to /planning/planner_selector
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <!-- PlannerSelector sets {selected_planner} on the blackboard -->
        <!-- Real-mode default planner restored to Smac2D.
             Sim mode uses a separate BT XML with GridBased default. -->
        <PlannerSelector selected_planner="{selected_planner}" default_planner="Smac2D" topic_name="/planning/planner_selector"/>
        <!-- Match planning-default BT replanning rate to reduce
             planner/costmap current-timeout pressure under real sensor load. -->
        <!-- HH_260513: Increased 1.5→3.0Hz. Faster replan reduces path-behind-robot offset. -->
        <RateController hz="3.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <!-- start port omitted: planner always queries current robot pose via TF. -->
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <!-- HH_260513: Smooth planner path before handing to FollowPath. -->
        <SmoothPath path="{path}" smoother_id="SimpleSmoother" check_for_collisions="false"/>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
