<!-- PlannerSelector-enabled BT (SIM profile).
  - Default planner: SmacLattice
  - Default controller: RPP
  - Optional controllers: MPPI, DWB, Graceful, RotationShim
  - Switch planner by publishing std_msgs/String to /planning/planner_selector
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateGoalLocked">
        <!-- PlannerSelector sets {selected_planner} on the blackboard -->
        <!-- HH_260618: Keep SIM-grid BT default aligned with the curvature-preserving route default. -->
        <PlannerSelector selected_planner="{selected_planner}" default_planner="SmacLattice" topic_name="/planning/planner_selector"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="RPP" topic_name="/planning/controller_selector"/>
        <!-- HH_260619 - Keep the SIM global route fixed per goal; local path
             updates remain continuous through /planning/local_path slicing. -->
        <GoalUpdatedController>
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" start="{start}" path="{path}" planner_id="{selected_planner}"/>
            <Sequence name="ClearGlobalCostmapAndSettle-Context">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              <!-- HH_260528: Costmap clear->replan race guard for SIM BT profile. -->
              <Wait wait_duration="0.4"/>
            </Sequence>
          </RecoveryNode>
        </GoalUpdatedController>
        <!-- HH_260618: Smooth selected planner path before handing to FollowPath. -->
        <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="SimpleSmoother" check_for_collisions="false"/>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <!-- HH_260528: Let clear services settle before the next recovery branch/planner retry. -->
            <Wait wait_duration="0.4"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
