<CycloneDDS>
  <!-- HH_260521 - Define the camera DDS profile; mirrored into bringup on HH_260624. -->
  <Domain>
    <Tracing>
      <Verbosity>severe</Verbosity>
    </Tracing>
    <SharedMemory>
      <Enable>false</Enable>
    </SharedMemory>
    <Internal>
      <!-- HH_260521 - Reserve >=20 MiB socket buffers for 1080p BGR8 frames; mirrored on HH_260624. -->
      <SocketReceiveBufferSize min="20971520B"/>
      <SocketSendBufferSize min="20971520B"/>
    </Internal>
  </Domain>
</CycloneDDS>
