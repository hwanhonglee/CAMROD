# ── Goal ────────────────────────────────────────────────────────────────────
string dock_id                      # docks.yaml의 dock id (e.g. "home_dock")
float32 max_staging_time 120.0      # staging 이동 타임아웃 (초) — DockRobot에 전달
float32 dock_timeout_sec 60.0       # 전체 도킹 타임아웃 (초)
---
# ── Result ──────────────────────────────────────────────────────────────────
bool success
string message                      # 성공/실패 사유
float32 total_elapsed_sec           # 전체 소요 시간
uint16 error_code                   # DockRobot error_code 그대로 전달 (0=none)
---
# ── Feedback ────────────────────────────────────────────────────────────────
# DockRobot feedback state 상수 (relay)
uint16 PHASE_NONE=0
uint16 PHASE_NAV_TO_STAGING=1
uint16 PHASE_INITIAL_PERCEPTION=2
uint16 PHASE_CONTROLLING=3
uint16 PHASE_WAIT_FOR_CHARGE=4
uint16 PHASE_RETRY=5

uint16 state                        # DockRobot feedback.state relay
string phase_label                  # 사람이 읽을 수 있는 phase 이름
builtin_interfaces/Duration docking_time
uint16 num_retries
