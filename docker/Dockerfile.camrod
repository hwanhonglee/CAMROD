#
# NOTE:
# Use official `ros:humble` multi-arch base so linux/amd64 + linux/arm64
# images are both truly native userlands.
#
FROM ros:humble AS builder

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV WS_DIR=/home/camrod_ws
ENV CAMROD_SOURCE_PATHS="\
camrod_bringup \
camrod_common \
camrod_localization \
camrod_map \
camrod_perception \
camrod_planning \
camrod_platform \
camrod_sensing \
camrod_sensor_kit \
camrod_system \
camrod_sensing/external/ublox \
camrod_sensing/external/vanjee_lidar \
camrod_map/external/lanelet2"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    ca-certificates \
    libpython3-dev \
    python3-dev \
    python3.10-dev \
    python3-pip \
    python3-rosdep \
    python3-vcstool \
    python3-colcon-common-extensions \
    python3-argcomplete \
    python3-empy \
    python3-lark \
    python3-numpy \
    python3-yaml \
    libeigen3-dev \
    libpugixml-dev \
    libssl-dev \
    ros-humble-xacro \
    ros-humble-nav2-behaviors \
    ros-humble-vision-msgs \
    ros-humble-rmw-fastrtps-cpp \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rcutils \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true
RUN rosdep update --rosdistro ${ROS_DISTRO}

WORKDIR ${WS_DIR}

# Build context is CAMROD repository root where packages are placed directly
# under `${WS_DIR}`.
COPY . ${WS_DIR}

# Ensure host-side build artifacts never affect container colcon resolution.
RUN rm -rf build install log

# Fail fast with clear guidance when wrong build context is used.
RUN test -d camrod_bringup || ( \
    echo "ERROR: build context must be CAMROD root containing package folders"; \
    echo "       expected path: /home/camrod_ws/camrod_bringup"; \
    ls -la; \
    exit 1 )

# Install dependencies only for runtime source paths.
# Keep this list explicit so `todo/*` or other experimental folders
# cannot break Docker builds.
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    apt-get update && \
    rosdep install \
      --rosdistro ${ROS_DISTRO} \
      --from-paths ${CAMROD_SOURCE_PATHS} \
      --dependency-types build \
      --dependency-types buildtool \
      --dependency-types exec \
      --ignore-src \
      -r -y

# Re-assert OpenSSL development files after rosdep resolution.
# Some dependency combinations (notably ublox_gps + rmw_fastrtps in arm64
# emulated builds) can fail CMake OpenSSL detection if libcrypto path isn't
# resolved explicitly at configure time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Build the full CAMROD runtime workspace.
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    DEB_ARCH="$(dpkg-architecture -qDEB_HOST_MULTIARCH)" && \
    OPENSSL_ROOT_DIR=/usr && \
    OPENSSL_SSL_LIBRARY="/usr/lib/${DEB_ARCH}/libssl.so" && \
    OPENSSL_CRYPTO_LIBRARY="/usr/lib/${DEB_ARCH}/libcrypto.so" && \
    colcon build \
      --event-handlers console_direct+ \
      --parallel-workers 2 \
      --base-paths ${CAMROD_SOURCE_PATHS} \
      --cmake-args \
      -DBUILD_TESTING=OFF \
      -DPython3_EXECUTABLE=/usr/bin/python3 \
      -DPython_EXECUTABLE=/usr/bin/python3 \
      -DPython3_FIND_STRATEGY=LOCATION \
      -DOPENSSL_ROOT_DIR="${OPENSSL_ROOT_DIR}" \
      -DOPENSSL_SSL_LIBRARY="${OPENSSL_SSL_LIBRARY}" \
      -DOPENSSL_CRYPTO_LIBRARY="${OPENSSL_CRYPTO_LIBRARY}"


FROM builder AS runtime

SHELL ["/bin/bash", "-lc"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV WS_DIR=/home/camrod_ws
WORKDIR ${WS_DIR}

COPY docker/entrypoint.camrod.sh /entrypoint.camrod.sh
RUN chmod +x /entrypoint.camrod.sh

# Keep Fast DDS as default in container runtime so launch works out-of-the-box
# without requiring extra CycloneDDS runtime packages.
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_LOCALHOST_ONLY=0

ENTRYPOINT ["/entrypoint.camrod.sh"]
CMD ["ros2", "launch", "camrod_bringup", "bringup.launch.py"]
