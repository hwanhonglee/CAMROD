<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camrod_planning</name>
  <version>0.0.0</version>
  <description>Nav2-based planning wrapper for the camping cart (includes lanelet goal snapping)</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <!-- HH_260617: Use SPDX-style license naming for package metadata consistency. -->
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- HH_260112: Add goal snapper node dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- HH_260618: nav2_core/pluginlib are required for EngageAwareProgressChecker. -->
  <depend>nav2_core</depend>
  <depend>nav2_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_srvs</depend>
  <depend>action_msgs</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_projection</depend>
  <depend>lanelet2_routing</depend>
  <depend>lanelet2_traffic_rules</depend>
  <depend>camrod_map</depend>
  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>avg_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- HH_260105: Nav2 runtime components used by nav2_lanelet.launch.py -->
  <!-- Nav2 runtime components used by nav2_lanelet.launch.py -->
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- HH_260618: Export CAMROD progress checker to Nav2 controller_server. -->
    <nav2_core plugin="${prefix}/progress_checker_plugins.xml"/>
    <!-- HH_260619: Export CAMROD lanelet centerline planner to Nav2 planner_server. -->
    <nav2_core plugin="${prefix}/global_planner_plugins.xml"/>
  </export>
</package>
