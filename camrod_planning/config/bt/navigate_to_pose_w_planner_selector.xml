<!-- PlannerSelector-enabled BT.
  - Default planner: LaneletRoute
  - Optional planners: Smac2D, NavFn, SmacHybrid, SmacLattice
  - Default controller: RPP
  - Optional controllers: MPPI, DWB, Graceful, RotationShim
  - HH_260720 - Switch planner through the explicit std_msgs boundary.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateGoalLocked">
        <!-- PlannerSelector sets {selected_planner} on the blackboard -->
        <!-- HH_260727 - Default to connected lanelet routing; grid planners are
             selectable only through the explicit manual/regulated source policy. -->
        <PlannerSelector selected_planner="{selected_planner}" default_planner="LaneletRoute" topic_name="/planning/planner_selector_ros"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="RPP" topic_name="/planning/controller_selector_ros"/>
        <!-- HH_260727 - Manual goals require yaw completion; regulated site goals
             retain the lanelet handoff tolerance. -->
        <GoalCheckerSelector selected_goal_checker="{selected_goal_checker}" default_goal_checker="goal_checker" topic_name="/planning/goal_checker_selector_ros"/>
        <!-- HH_260619 - Lock the global route after each accepted goal.
             GoalUpdatedController computes a new global path only on the first
             tick, goal preemption, or recovery restart. The local path extractor
             then slices the fixed global route around the live robot pose. -->
        <GoalUpdatedController>
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <!-- HH_260727 - The goal-source latch owns planner policy; a hidden
                 fallback must not turn regulated failures into unrestricted routes. -->
            <!-- HH_260619 - Pass the navigator-provided snapped start pose.
                 Without start="{start}", ComputePathToPose silently plans from
                 current TF and draws a short off-center connector near the robot. -->
            <ComputePathToPose goal="{goal}" start="{start}" path="{path}" planner_id="{selected_planner}"/>
            <Sequence name="ClearGlobalCostmapAndSettle-Context">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              <!-- HH_260528 - Costmap clear->replan race guard.
                   Give global layers one short cycle to repopulate before retrying ComputePath. -->
              <Wait wait_duration="0.4"/>
            </Sequence>
          </RecoveryNode>
        </GoalUpdatedController>
        <!-- HH_260630 - Smooth every planner result before FollowPath. Collision
             checking is disabled here because long LaneletRoute paths can extend
             outside the rolling/global costmap window and falsely abort smoothing. -->
        <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="SimpleSmoother" check_for_collisions="false"/>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" goal_checker_id="{selected_goal_checker}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <!-- HH_260528 - Let clear services settle before the next recovery branch/planner retry. -->
            <Wait wait_duration="0.4"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
