+def rotation_controller(module):
+    controller = _bare_command_controller(module)
+    controller.experimental_zero_turn_yaw_integral_enabled = True
+    controller._experimental_zero_turn_yaw_integral = ExperimentalZeroTurnYawIntegral()
+    controller.loginfo = lambda message: None
+    clock = [20.0]
+    controller.get_time = lambda: clock[0]
+    command = _extended_command(0.0, False, mode=2)
+    command.yaw_rate_cmd = 0.1
+    controller._on_extended_cmd(command)
+    controller._physical_command_armed = True
+    controller.odometry_timeout_sec = 0.25
+    controller.rotation_wheel_torque_limit_nm = 2.0
+    controller.rotation_recovery_breakaway_torque_limit_nm = 4.0
+    controller.yaw_rate_torque_kp = 5.0
+    controller.zero_turn_fallback_yaw_rate_radps = 0.3
+    controller.max_physical_yaw_rate_radps = 1.0
+    controller._odometry = SimpleNamespace(twist=SimpleNamespace(
+        twist=SimpleNamespace(angular=SimpleNamespace(z=0.0))))
+    controller._odometry_time = clock[0]
+    solution = SimpleNamespace(steering_converged=True,
+        drive_signs=(1, -1, 1, -1), wheel_speed_scales=(1.0,)*4)
+    return controller, clock, command, solution
+
+
+def test_real_node_hook_adds_signed_integral_under_same_two_nm_cap(controller_module):
+    controller, clock, command, solution = rotation_controller(controller_module)
+    assert controller._compute_wheel_torques(solution) == (-0.5, 0.5, -0.5, 0.5)
+    for index in range(1, 201):
+        clock[0] = 20.0 + index*0.05
+        controller._on_extended_cmd(command)
+        controller._odometry_time = clock[0]
+        torques = controller._compute_wheel_torques(solution)
+        assert max(abs(v) for v in torques) <= 2.0
+    assert torques == (-2.0, 2.0, -2.0, 2.0)
+    controller._odometry.twist.twist.angular.z = 0.15
+    assert controller._compute_wheel_torques(solution) == pytest.approx((0.25, -0.25, 0.25, -0.25))
+    assert controller._experimental_zero_turn_yaw_integral.integrated_error_rad == 0.0
+
+
+def test_real_node_default_disabled_preserves_p_path(controller_module):
+    controller, clock, command, solution = rotation_controller(controller_module)
+    controller.experimental_zero_turn_yaw_integral_enabled = False
+    for index in range(10):
+        clock[0] = 20.0 + index*0.05
+        controller._on_extended_cmd(command)
+        controller._odometry_time = clock[0]
+        assert controller._compute_wheel_torques(solution) == (-0.5, 0.5, -0.5, 0.5)
+
+
+@pytest.mark.parametrize("action", (
+    "stop", "sign", "unconverged", "stale", "reset", "large_target", "recovery"))
+def test_real_node_resets_at_command_and_feedback_boundaries(controller_module, action):
+    controller, clock, command, solution = rotation_controller(controller_module)
+    controller._compute_wheel_torques(solution)
+    clock[0] += 0.1
+    controller._compute_wheel_torques(solution)
+    tracker = controller._experimental_zero_turn_yaw_integral
+    assert tracker.integrated_error_rad != 0.0
+    if action in ("stop", "sign"):
+        command.yaw_rate_cmd = 0.0 if action == "stop" else -0.1
+        controller._on_extended_cmd(command)
+    elif action == "large_target":
+        command.yaw_rate_cmd = 0.3
+        controller._on_extended_cmd(command)
+    elif action == "recovery":
+        command.recovery_breakaway_authorized = True
+        controller._on_extended_cmd(command)
+    elif action == "unconverged":
+        solution.steering_converged = False
+        assert controller._compute_wheel_torques(solution) == (0.0,)*4
+    elif action == "stale":
+        clock[0] += 0.3
+        with pytest.raises(ValueError, match="stale"):
+            controller._compute_wheel_torques(solution)
+    else:
+        controller._publish_physical_reset()
+    assert tracker.integrated_error_rad == 0.0
