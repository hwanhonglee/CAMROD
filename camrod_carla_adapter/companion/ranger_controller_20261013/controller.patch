+    assert tracker.reference_yaw_rad is None
+
+
+@pytest.mark.parametrize("changes", [{"armed":False},{"steering_converged":False},
+                                     {"target_speed_mps":0.}])
+def test_ineligible_active_motion_returns_all_zero_and_resets(changes):
