+    assert tracker.reference_yaw_rad is None
+    with pytest.raises(ValueError):sample(tracker,now=.1)
+    tracker.reset()  # Internal stop/unarm does not clear the fault.
+    with pytest.raises(ValueError):sample(tracker,now=.2)
+    assert sample(tracker,now=.3,target_speed_mps=0.) == (0.,)*4
