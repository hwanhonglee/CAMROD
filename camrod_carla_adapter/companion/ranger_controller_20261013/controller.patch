+"""HH_261007 - Opt-in CARLA-only axle-reduction yaw hold, not acceptance proof.
+
+Unlike the unused 8 Nm zero-sum allocator, this experiment never increases a
+wheel torque. One axle can lose up to 40% of its baseline magnitude, leaving
+all four wheels driven with the same sign even at the experimental 16 Nm cap.
+"""
+from dataclasses import dataclass
+import math
+
+
+def finite(value, name):
+    if isinstance(value, bool):
+        raise ValueError(name + " must be finite, not boolean")
+    try:
+        result = float(value)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError(name + " must be finite") from exc
+    if not math.isfinite(result):
+        raise ValueError(name + " must be finite")
+    return result
+
+
+def wrap_angle(value):
+    return math.atan2(math.sin(value), math.cos(value))
+
+
+def quaternion_yaw(x, y, z, w):
+    q = [finite(v, "odometry quaternion") for v in (x, y, z, w)]
+    norm = math.sqrt(sum(v*v for v in q))
+    if not 0.5 <= norm <= 1.5:
+        raise ValueError("odometry quaternion norm is invalid")
+    x, y, z, w = [v/norm for v in q]
+    return math.atan2(2*(w*z+x*y), 1-2*(y*y+z*z))
+
+
+@dataclass(frozen=True)
+class CrabYawHoldConfig:
+    # HH_261007 - At 5 deg error and 0.1 rad/s drift, request ~2.30 Nm
+    # reduction, not an immediate maximum trim. These are trial gains only.
+    heading_gain_nm_per_rad: float = 8.0
+    rate_gain_nm_per_radps: float = 16.0
+    maximum_reduction_fraction: float = 0.40
+    maximum_heading_error_deg: float = 12.0
+    maximum_yaw_rate_degps: float = 18.0
+    stall_timeout_sec: float = 4.0
+    stall_progress_mps: float = 0.05
+    odometry_timeout_sec: float = 0.25
+    torque_limit_nm: float = 16.0
+
+    def __post_init__(self):
+        bounds = {
+            "heading_gain_nm_per_rad": (0., 16.),
+            "rate_gain_nm_per_radps": (0., 32.),
+            "maximum_reduction_fraction": (0., .40),
+            "maximum_heading_error_deg": (0., 15.),
+            "maximum_yaw_rate_degps": (0., 30.),
+            "stall_timeout_sec": (0., 5.),
+            "stall_progress_mps": (0., .10),
+            "odometry_timeout_sec": (0., .25),
+        }
+        for name, (low, high) in bounds.items():
+            value = finite(getattr(self, name), name)
+            if not low < value <= high:
+                raise ValueError(name + " is outside experimental bounds")
+            object.__setattr__(self, name, value)
+        if finite(self.torque_limit_nm, "torque_limit_nm") != 16.:
+            raise ValueError("experimental yaw hold requires the 16 Nm cap")
+        object.__setattr__(self, "torque_limit_nm", 16.)
+
+
+@dataclass(frozen=True)
+class CrabYawHoldResult:
+    torques_nm: tuple
+    reference_yaw_rad: float
+    heading_error_rad: float
+    requested_difference_nm: float
+    reduced_axle: str
+    reduction_nm: float
+    reason: str
+
+
+class ExperimentalCrabYawHold:
+    """Heading reference and bounded stall supervisor for one CRAB episode.
+
+    Faults latch until an explicit zero/mode-changing command clears them.
+    Internal unarm/reset only discards reference/timing, never auto-rearms a
+    fault against a continuously repeated nonzero upstream command.
+    """
+    def __init__(self, config=None):
+        self.config = config or CrabYawHoldConfig()
+        if not isinstance(self.config, CrabYawHoldConfig):
+            raise ValueError("CrabYawHoldConfig required")
+        self.fault_reason = ""
+        self.reset()
+
+    def reset(self, clear_fault=False):
+        self.reference_yaw_rad = None
+        self.last_time = None
+        self.stall_since = None
+        self.direction_key = None
+        self.last_result = None
+        if clear_fault:
+            self.fault_reason = ""
+
+    def _fault(self, reason):
+        self.reset()
+        self.fault_reason = "experimental CRAB yaw hold: " + reason
+        raise ValueError(self.fault_reason)
+
+    def update(self, baseline_torques_nm, *, now, enabled, drive_mode,
+               armed, steering_converged, crab_angle_ros_rad,
+               target_speed_mps, signed_speed_mps, heading_ros_rad,
+               yaw_rate_ros_radps, odometry_age_s):
+        for name, value in (("enabled", enabled), ("armed", armed),
+                            ("steering_converged", steering_converged)):
+            if type(value) is not bool:
+                self._fault(name + " must be boolean")
+        try:
+            baseline = tuple(finite(v, "baseline torque") for v in baseline_torques_nm)
+            if len(baseline) != 4:
+                raise ValueError("four FL/FR/RL/RR torques required")
+            if type(drive_mode) is not int or drive_mode not in (0, 1, 2, 3):
+                raise ValueError("unknown drive mode")
+            beta = finite(crab_angle_ros_rad, "crab angle")
+            target = finite(target_speed_mps, "target speed")
+        except (TypeError, ValueError) as exc:
+            self._fault(str(exc))
+        if not enabled or drive_mode != 1 or abs(beta) < math.radians(80.):
+            self.reset(clear_fault=True)
+            return baseline
+        if abs(target) <= 1e-6:
+            self.reset(clear_fault=True)
+            return (0.,)*4
+        if not armed or not steering_converged:
+            self.reset()
+            return (0.,)*4
+        if self.fault_reason:
+            raise ValueError(self.fault_reason)
+        if all(v == 0. for v in baseline):
+            self.reset()
+            return baseline
+        try:
+            t = finite(now, "time")
+            heading = finite(heading_ros_rad, "heading")
+            rate = finite(yaw_rate_ros_radps, "yaw rate")
+            speed = finite(signed_speed_mps, "signed speed")
+            age = finite(odometry_age_s, "odometry age")
+            if not 0. <= age <= self.config.odometry_timeout_sec:
+                raise ValueError("stale odometry")
+            # HH_261007 - ExtendedAckermannDrive is float32 on the wire;
+            # match the bridge's 0.0001-degree representation tolerance.
+            if abs(beta) > math.radians(88. + 1e-4):
+                raise ValueError("CRAB steering exceeds 88 degrees")
+            if any(v == 0. or abs(v) > self.config.torque_limit_nm for v in baseline):
+                raise ValueError("all four nonzero torques must be within 16 Nm")
+            if any((v > 0.) != (baseline[0] > 0.) for v in baseline):
+                raise ValueError("all four torques must have the same sign")
+            if max(abs(v-baseline[0]) for v in baseline) > 1e-6:
+                raise ValueError("extreme CRAB baseline must be a common scalar")
+            if self.last_time is not None and (t < self.last_time or t-self.last_time > .25):
+                raise ValueError("time discontinuity")
+        except (TypeError, ValueError) as exc:
+            self._fault(str(exc))
+        direction = (target > 0., beta > 0.)
+        if self.direction_key is not None and direction != self.direction_key:
+            self.reset()
+        self.direction_key = direction
+        self.last_time = t
+        if self.reference_yaw_rad is None:
+            self.reference_yaw_rad = heading
+        error = wrap_angle(heading-self.reference_yaw_rad)
+        if abs(error) > math.radians(self.config.maximum_heading_error_deg):
+            self._fault("heading drift exceeded {:.1f} degrees".format(self.config.maximum_heading_error_deg))
+        if abs(rate) > math.radians(self.config.maximum_yaw_rate_degps):
+            self._fault("yaw rate exceeded {:.1f} deg/s".format(self.config.maximum_yaw_rate_degps))
+        progress = math.copysign(1., target)*speed
+        threshold = min(self.config.stall_progress_mps, .25*abs(target))
+        if progress < threshold:
+            if self.stall_since is None:
+                self.stall_since = t
+            elif t-self.stall_since >= self.config.stall_timeout_sec:
+                self._fault("signed progress stalled for {:.1f} seconds".format(self.config.stall_timeout_sec))
+        else:
+            self.stall_since = None
+        # HH_261007 - Desired signed (front minus rear) torque difference.
+        # Reducing positive front torque or negative rear torque both produce
+        # a negative difference; this handles reverse and beta +/- correctly.
+        requested = -(self.config.heading_gain_nm_per_rad*error +
+                      self.config.rate_gain_nm_per_radps*rate)/math.sin(beta)
+        magnitude = min(abs(requested), self.config.maximum_reduction_fraction*abs(baseline[0]))
+        front = requested*baseline[0] < 0.
+        axle = (0, 1) if front else (2, 3)
+        torques = list(baseline)
+        for index in axle:
+            torques[index] -= math.copysign(magnitude, baseline[index])
+        result = tuple(torques)
+        if any(abs(v) > abs(b) or v*b <= 0. for v,b in zip(result,baseline)):
+            self._fault("reduction violated same-sign baseline bounds")
+        self.last_result = CrabYawHoldResult(result,self.reference_yaw_rad,error,
+            requested,"front" if front else "rear",magnitude,"experimental_unqualified")
+        return result
