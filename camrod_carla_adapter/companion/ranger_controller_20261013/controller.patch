@@ -0,0 +1,135 @@
+"""HH_261006 - Pure, unqualified CRAB torque allocation; no runtime authority.
+
+This explicit front/rear allocation is NOT the existing scalar-times-speed-scale
+contract. Nothing imports or activates it in the controller or physical bridge.
+Offline algebra tests do not establish physical acceptance or a safe tuned gain.
+"""
+
+from dataclasses import dataclass
+import math
+
+
+CRAB_MODE = 1
+MINIMUM_CRAB_ANGLE_RAD = math.radians(80.0)
+PHYSICAL_STEER_LIMIT_RAD = math.radians(89.0)
+MAXIMUM_EXTREME_CRAB_TORQUE_NM = 8.0
+MAXIMUM_TRIM_FRACTION = 0.4
+MAXIMUM_ODOMETRY_AGE_S = 0.25
+
+
+@dataclass(frozen=True)
+class CrabYawTorqueAllocation:
+    """Explicit FL/FR/RL/RR baseline, signed axle trim and resulting torques."""
+
+    baseline_torques_nm: tuple
+    torques_nm: tuple
+    requested_trim_nm: float
+    applied_trim_nm: float
+    limited: bool
+    reason: str
+
+
+def _finite_number(value, name):
+    if isinstance(value, bool):
+        raise ValueError("{} must be a finite number, not boolean".format(name))
+    try:
+        number = float(value)
+    except (TypeError, ValueError, OverflowError) as error:
+        raise ValueError("{} must be a finite number".format(name)) from error
+    if not math.isfinite(number):
+        raise ValueError("{} must be finite".format(name))
+    return number
+
+
+def allocate_crab_yaw_balanced_torques(
+        baseline_torques_nm, *, drive_mode, crab_angle_ros_rad,
+        measured_yaw_rate_ros_radps, odometry_age_s, steering_converged,
+        gain_nm_per_radps, maximum_trim_fraction, torque_limit_nm,
+        odometry_timeout_s):
+    """Allocate a bounded zero-sum front/rear trim around existing torques.
+
+    Inputs use ROS body axes: positive beta is left, positive yaw is CCW.
+    All tuning/envelope parameters are explicit; no gain is selected here.
+    FL/FR receive +trim and RL/RR receive -trim, where the unsaturated trim is
+    -gain * measured_yaw / sin(beta), targeting zero yaw rate. Baseline sign
+    does not multiply this expression: it also applies to reverse/braking torque.
+
+    Non-CRAB and non-extreme CRAB retain the baseline unchanged. An all-zero
+    baseline remains exactly zero, including during stale/unconverged stops.
+    Nonzero extreme CRAB requires fresh odometry, converged steering, all four
+    same-sign nonzero baseline torques and the existing <=8 N*m envelope.
+    Invalid or ineligible active inputs raise ValueError; a future caller must
+    choose its fail-closed stop behavior, never silently activate this helper.
+    """
+    try:
+        baseline = tuple(_finite_number(value, "baseline torque")
+                         for value in baseline_torques_nm)
+    except TypeError as error:
+        raise ValueError("baseline must contain exactly FL/FR/RL/RR") from error
+    if len(baseline) != 4:
+        raise ValueError("baseline must contain exactly FL/FR/RL/RR")
+    if type(drive_mode) is not int or drive_mode not in (0, 1, 2, 3):
+        raise ValueError("drive mode must be a known integer mode")
+    if type(steering_converged) is not bool:
+        raise ValueError("steering_converged must be boolean")
+
+    beta = _finite_number(crab_angle_ros_rad, "ROS crab angle")
+    yaw_rate = _finite_number(measured_yaw_rate_ros_radps, "ROS yaw rate")
+    age = _finite_number(odometry_age_s, "odometry age")
+    gain = _finite_number(gain_nm_per_radps, "yaw-rate gain")
+    fraction = _finite_number(maximum_trim_fraction, "maximum trim fraction")
+    limit = _finite_number(torque_limit_nm, "torque limit")
+    timeout = _finite_number(odometry_timeout_s, "odometry timeout")
+    if gain < 0.0:
+        raise ValueError("yaw-rate gain must be nonnegative")
+    if not 0.0 <= fraction <= MAXIMUM_TRIM_FRACTION:
+        raise ValueError("maximum trim fraction must be in [0, 0.4]")
+    if not 0.0 < limit <= MAXIMUM_EXTREME_CRAB_TORQUE_NM:
+        raise ValueError("extreme CRAB torque limit must be in (0, 8] N*m")
+    if not 0.0 < timeout <= MAXIMUM_ODOMETRY_AGE_S:
+        raise ValueError("odometry timeout must be in (0, 0.25] seconds")
+
+    def unchanged(reason):
+        return CrabYawTorqueAllocation(baseline, baseline, 0.0, 0.0, False, reason)
+
+    # HH_261006 - Do not modify other modes or turn an explicit stop into thrust.
+    if drive_mode != CRAB_MODE:
+        return unchanged("non_crab")
+    if all(value == 0.0 for value in baseline):
+        return unchanged("zero_baseline")
+    if abs(beta) >= PHYSICAL_STEER_LIMIT_RAD:
+        raise ValueError("CRAB angle must remain strictly below 89 degrees")
+    if abs(beta) < MINIMUM_CRAB_ANGLE_RAD:
+        return unchanged("not_near_orthogonal")
+    if not steering_converged:
+        raise ValueError("nonzero extreme CRAB requires converged steering")
+    if not 0.0 <= age <= timeout:
+        raise ValueError("nonzero extreme CRAB requires fresh odometry")
+    if (any(value == 0.0 or abs(value) > limit for value in baseline)
+            or any((value > 0.0) != (baseline[0] > 0.0) for value in baseline)):
+        raise ValueError("extreme CRAB baseline must be same-sign, nonzero and within cap")
+
+    requested = -gain * yaw_rate / math.sin(beta)
+    if not math.isfinite(requested):
+        raise ValueError("requested CRAB trim overflowed")
+    # HH_261006 - Intersect each wheel's signed torque bounds. With f<=0.4,
+    # every output retains at least 60% of its own baseline magnitude, never
+    # crosses zero, and stays within the pre-existing extreme-CRAB torque cap.
+    lower_trim, upper_trim = -math.inf, math.inf
+    axle_directions = (1.0, 1.0, -1.0, -1.0)
+    for base, axle in zip(baseline, axle_directions):
+        magnitude = abs(base)
+        lower_magnitude = (1.0 - fraction) * magnitude
+        upper_magnitude = min((1.0 + fraction) * magnitude, limit)
+        low, high = ((lower_magnitude, upper_magnitude) if base > 0.0
+                     else (-upper_magnitude, -lower_magnitude))
+        wheel_bounds = ((low - base) / axle, (high - base) / axle)
+        lower_trim = max(lower_trim, min(wheel_bounds))
+        upper_trim = min(upper_trim, max(wheel_bounds))
+    applied = max(lower_trim, min(upper_trim, requested))
+    torques = tuple(base + axle * applied for base, axle in zip(baseline, axle_directions))
+    if any(not math.isfinite(value) or value == 0.0 or abs(value) > limit
+           or (value > 0.0) != (base > 0.0) for value, base in zip(torques, baseline)):
+        raise ValueError("allocated CRAB torque failed the signed envelope")
+    return CrabYawTorqueAllocation(
+        baseline, torques, requested, applied, applied != requested, "allocated")
