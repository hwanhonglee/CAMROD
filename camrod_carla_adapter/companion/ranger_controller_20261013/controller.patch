+
+def sample(tracker, baseline=(16.,)*4, **changes):
+    args = dict(now=0., enabled=True, drive_mode=1, armed=True,
+                steering_converged=True, crab_angle_ros_rad=math.radians(88.),
+                target_speed_mps=.667, signed_speed_mps=.2,
+                heading_ros_rad=0., yaw_rate_ros_radps=0., odometry_age_s=0.)
+    args.update(changes)
+    return tracker.update(baseline, **args)
+
+
+@pytest.mark.parametrize("torque_sign", (-1.,1.))
+@pytest.mark.parametrize("beta_sign", (-1.,1.))
+@pytest.mark.parametrize("yaw_sign", (-1.,1.))
+def test_reduction_counteracts_yaw_forward_reverse_left_right(torque_sign,beta_sign,yaw_sign):
+    tracker = ExperimentalCrabYawHold()
+    baseline = (16.*torque_sign,)*4
+    result = sample(tracker,baseline,crab_angle_ros_rad=beta_sign*math.radians(88.),
+                    target_speed_mps=torque_sign*.667,signed_speed_mps=torque_sign*.2,
+                    yaw_rate_ros_radps=yaw_sign*.1)
+    # Signed front-minus-rear torque maps to yaw by sin(beta), independent
+    # of the sign of translation or braking torque.
+    yaw_moment_proxy = (result[0]+result[1]-result[2]-result[3])*beta_sign
+    assert yaw_moment_proxy*yaw_sign < 0.
+    assert (result[:2] == baseline[:2]) != (result[2:] == baseline[2:])
+    assert result[0] == result[1] and result[2] == result[3]
+    assert all(.6*abs(b) <= abs(v) <= abs(b) and v*b>0 for v,b in zip(result,baseline))
+
+
+def test_heading_reference_persists_and_wraps_at_pi():
+    tracker=ExperimentalCrabYawHold()
+    sample(tracker,heading_ros_rad=math.radians(179.))
+    result=sample(tracker,now=.1,heading_ros_rad=math.radians(-179.))
+    assert tracker.last_result.heading_error_rad == pytest.approx(math.radians(2.))
+    assert result[0] < result[2] == 16.
+    assert tracker.reference_yaw_rad == pytest.approx(math.radians(179.))
+
+
+def test_maximum_reduction_is_forty_percent_and_never_cap_increase():
+    tracker=ExperimentalCrabYawHold(CrabYawHoldConfig(rate_gain_nm_per_radps=32.))
+    result=sample(tracker,yaw_rate_ros_radps=math.radians(17.))
+    assert result == pytest.approx((9.6,9.6,16.,16.))
+
+
+@pytest.mark.parametrize("changes", [
+    {"enabled":False},{"drive_mode":0},{"crab_angle_ros_rad":math.radians(79.)},
+])
+def test_disabled_and_other_modes_keep_original_scalar_contract(changes):
