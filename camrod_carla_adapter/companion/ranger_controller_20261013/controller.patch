+"""HH_261008 - Default-off CARLA yaw tracking experiment, not physical proof.
+
+The ordinary proportional controller and its 2 N*m wheel ceiling are unchanged.
+This helper adds only accumulated, signed yaw-rate error for small ZERO_TURN
+commands. It is not a minimum torque or an expansion of recovery authority.
+"""
+from dataclasses import dataclass
+import math
+
+
+def _finite(value, name):
+    if isinstance(value, bool):
+        raise ValueError(name + " must be finite, not boolean")
+    try:
+        result = float(value)
+    except (ValueError, TypeError, OverflowError) as exc:
+        raise ValueError(name + " must be finite") from exc
+    if not math.isfinite(result):
+        raise ValueError(name + " must be finite")
+    return result
+
+
+@dataclass(frozen=True)
+class ZeroTurnYawIntegralConfig:
+    # Integral of yaw-rate error has units rad; Ki therefore has units N*m/rad.
+    # At a persistent 0.1 rad/s error this candidate adds 0.2 N*m each second.
+    integral_gain_nm_per_rad: float = 2.0
+
+    def __post_init__(self):
+        value = _finite(self.integral_gain_nm_per_rad, "integral gain")
+        if not 0.0 < value <= 2.0:
+            raise ValueError("experimental yaw integral gain must be in (0, 2]")
+        object.__setattr__(self, "integral_gain_nm_per_rad", value)
+
+
+@dataclass(frozen=True)
+class ZeroTurnYawIntegralResult:
+    target_radps: float
+    current_radps: float
+    error_radps: float
+    integrated_error_rad: float
+    integral_torque_nm: float
+    proportional_torque_nm: float
+    scalar_torque_nm: float
+    reason: str
+
+
+class ExperimentalZeroTurnYawIntegral:
+    """Bounded integral addition with immediate brake/stop/interlock reset.
+
+    HH_261008 - All rates share one signed frame (CARLA at the node hook).
+    Projection onto instantaneous proportional headroom is anti-windup: no
+    hidden integral can accumulate beyond the unchanged 2 N*m scalar limit.
+    Reaching the target discards the integral, retaining exact P-only braking.
+    """
+    def __init__(self, config=None):
+        self.config = config or ZeroTurnYawIntegralConfig()
+        if not isinstance(self.config, ZeroTurnYawIntegralConfig):
+            raise ValueError("ZeroTurnYawIntegralConfig required")
+        self.reset()
+
+    def reset(self):
+        self.integrated_error_rad = 0.0
+        self.last_time = None
+        self.direction = None
+        self.last_result = None
+
+    def update(self, *, now, enabled, drive_mode, armed, backend_accepted,
+               steering_converged, target_yaw_rate_radps,
+               current_yaw_rate_radps, target_translation_mps,
+               odometry_age_s, command_age_s, recovery_authorized=False):
+        try:
+            for name, value in (
+                    ("enabled", enabled), ("armed", armed),
+                    ("backend accepted", backend_accepted),
+                    ("steering converged", steering_converged),
+                    ("recovery authorized", recovery_authorized)):
+                if type(value) is not bool:
+                    raise ValueError(name + " must be boolean")
+            if type(drive_mode) is not int or drive_mode not in (0, 1, 2, 3):
+                raise ValueError("unknown drive mode")
+            t, target, current, translation, age, command_age = (
+                _finite(value, name) for value, name in (
+                    (now, "time"), (target_yaw_rate_radps, "yaw target"),
+                    (current_yaw_rate_radps, "yaw feedback"),
+                    (target_translation_mps, "translation target"),
+                    (odometry_age_s, "odometry age"),
+                    (command_age_s, "command age")))
+            if enabled and not (0.0 <= age <= 0.25 and
+                                0.0 <= command_age <= 0.5):
+                raise ValueError("experimental yaw integral feedback/command stale")
+        except (ValueError, TypeError):
+            self.reset()
+            raise
+
+        error = target - current
+        proportional = (max(-2.0, min(2.0, 5.0 * error))
+                        if abs(target) > 1.0e-4 else 0.0)
+        reason = "experimental_unqualified"
+        if not enabled:
+            reason = "disabled"
+        elif not armed or not backend_accepted or not steering_converged:
+            reason = "interlock"
+        elif (drive_mode != 2 or abs(translation) > 1.0e-6 or
+              recovery_authorized):
+            reason = "outside_zero_turn_episode"
+        elif not 1.0e-4 < abs(target) <= 0.2:
+            reason = "outside_small_yaw_target"
+        elif math.copysign(1.0, target) * error <= 0.0:
+            reason = "target_reached_or_overspeed"
+
+        if reason != "experimental_unqualified":
+            self.reset()
+        else:
+            direction = math.copysign(1.0, target)
+            if self.direction is not None and direction != self.direction:
+                self.reset()
+                reason = "direction_reset"
+            if self.last_time is not None:
+                dt = t - self.last_time
+                if dt < 0.0 or dt > 0.25:
+                    self.reset()
+                    reason = "time_discontinuity_reset"
+                else:
+                    self.integrated_error_rad += error * dt
+            # HH_261008 - Project state itself, not just output, onto remaining
+            # proportional headroom. A changed target cannot release windup.
+            headroom_nm = max(0.0, 2.0 - direction * proportional)
+            magnitude_rad = min(
+                max(0.0, direction * self.integrated_error_rad),
+                headroom_nm / self.config.integral_gain_nm_per_rad)
+            self.integrated_error_rad = direction * magnitude_rad
+            self.last_time = t
+            self.direction = direction
+
+        integral = self.config.integral_gain_nm_per_rad * self.integrated_error_rad
+        self.last_result = ZeroTurnYawIntegralResult(
+            target, current, error, self.integrated_error_rad, integral,
+            proportional, max(-2.0, min(2.0, proportional + integral)), reason)
+        return integral
