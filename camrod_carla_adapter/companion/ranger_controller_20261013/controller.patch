+"""HH_261008 - Offline PI algebra/interlocks, not B4 physical acceptance."""
+import math
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from carla_extended_ackermann_control.experimental_zero_turn_yaw_integral import (
+    ExperimentalZeroTurnYawIntegral, ZeroTurnYawIntegralConfig,
+)
+from carla_extended_ackermann_control.wheel_torque_control import compute_bounded_wheel_torques
+from test_physical_four_wheel_steering import (
+    controller_module, _bare_command_controller, _extended_command,
+)
+
+
+def sample(tracker, **changes):
+    args = dict(now=0.0, enabled=True, drive_mode=2, armed=True,
+                backend_accepted=True, steering_converged=True,
+                target_yaw_rate_radps=0.1, current_yaw_rate_radps=0.0,
+                target_translation_mps=0.0, odometry_age_s=0.0,
+                command_age_s=0.0, recovery_authorized=False)
+    args.update(changes)
+    return tracker.update(**args)
+
+
+@pytest.mark.parametrize("direction", (-1.0, 1.0))
+def test_integral_has_correct_units_and_same_sign_without_initial_floor(direction):
+    tracker = ExperimentalZeroTurnYawIntegral()
+    assert sample(tracker, target_yaw_rate_radps=direction*0.1) == 0.0
+    for index in range(1, 11):
+        result = sample(tracker, now=index*0.1,
+                        target_yaw_rate_radps=direction*0.1)
+    assert tracker.integrated_error_rad == pytest.approx(direction*0.1)
+    assert result == pytest.approx(direction*0.2)
+    assert tracker.last_result.scalar_torque_nm == pytest.approx(direction*0.7)
+
+
+@pytest.mark.parametrize("direction", (-1.0, 1.0))
+def test_saturation_projects_integral_state_and_cannot_release_hidden_windup(direction):
+    tracker = ExperimentalZeroTurnYawIntegral()
+    for index in range(1000):
+        sample(tracker, now=index*0.05, target_yaw_rate_radps=direction*0.1)
+    assert tracker.integrated_error_rad == pytest.approx(direction*0.75)
+    assert tracker.last_result.scalar_torque_nm == direction*2.0
+    # A larger error consumes P headroom and projects stored integral down.
+    sample(tracker, now=50.0, target_yaw_rate_radps=direction*0.2)
+    assert tracker.integrated_error_rad == pytest.approx(direction*0.5)
+    sample(tracker, now=50.05, target_yaw_rate_radps=direction*0.1)
+    assert tracker.last_result.scalar_torque_nm == pytest.approx(direction*1.51)
+
+
+@pytest.mark.parametrize("current", (0.1, 0.12, 0.4))
+@pytest.mark.parametrize("direction", (-1.0, 1.0))
+def test_reaching_or_exceeding_target_immediately_preserves_p_only_braking(current, direction):
+    tracker = ExperimentalZeroTurnYawIntegral()
+    sample(tracker, target_yaw_rate_radps=direction*0.1)
+    assert sample(tracker, now=0.1, target_yaw_rate_radps=direction*0.1) != 0.0
+    addition = sample(tracker, now=0.2, target_yaw_rate_radps=direction*0.1,
+                      current_yaw_rate_radps=direction*current)
+    assert addition == 0.0
+    assert tracker.integrated_error_rad == 0.0
+    factors = ((1, -1, 1, -1), (1.0,)*4)
+    assert compute_bounded_wheel_torques(
+        direction*0.1, direction*current, 5.0, 2.0, *factors,
+        feedforward_torque_nm=addition) == compute_bounded_wheel_torques(
+        direction*0.1, direction*current, 5.0, 2.0, *factors)
+
+
+@pytest.mark.parametrize("changes", [
+    {"enabled": False}, {"armed": False}, {"backend_accepted": False},
+    {"steering_converged": False}, {"drive_mode": 0}, {"drive_mode": 1},
+    {"drive_mode": 3}, {"target_yaw_rate_radps": 0.0},
+    {"target_yaw_rate_radps": 1.0e-4}, {"target_yaw_rate_radps": 0.201},
+    {"target_translation_mps": 0.01}, {"recovery_authorized": True},
+])
+def test_ineligible_episode_discards_integral_immediately(changes):
+    tracker = ExperimentalZeroTurnYawIntegral()
+    sample(tracker)
+    assert sample(tracker, now=0.1) > 0.0
+    assert sample(tracker, now=0.2, **changes) == 0.0
+    assert tracker.integrated_error_rad == 0.0
+    assert tracker.last_time is None
+
+
+@pytest.mark.parametrize("changes", [
+    {"now": math.nan}, {"current_yaw_rate_radps": math.inf},
+    {"target_yaw_rate_radps": math.nan}, {"target_translation_mps": math.nan},
+    {"odometry_age_s": -0.1}, {"odometry_age_s": 0.251},
+    {"command_age_s": -0.1}, {"command_age_s": 0.501},
+    {"enabled": "true"}, {"armed": 1}, {"backend_accepted": 1},
+    {"drive_mode": True}, {"drive_mode": 4}, {"current_yaw_rate_radps": True},
+])
+def test_invalid_or_stale_input_resets_then_raises(changes):
+    tracker = ExperimentalZeroTurnYawIntegral()
+    sample(tracker)
+    sample(tracker, now=0.1)
+    with pytest.raises(ValueError):
+        sample(tracker, **changes)
+    assert tracker.integrated_error_rad == 0.0
+    assert tracker.last_time is None
+
+
+@pytest.mark.parametrize("next_time", (0.05, 0.351))
+def test_time_regression_or_gap_cannot_integrate_unobserved_time(next_time):
+    tracker = ExperimentalZeroTurnYawIntegral()
+    sample(tracker)
+    sample(tracker, now=0.1)
+    assert sample(tracker, now=next_time) == 0.0
+    assert tracker.last_result.reason == "time_discontinuity_reset"
+
+
+def test_duplicate_timestamp_neither_accumulates_nor_loses_state():
+    tracker = ExperimentalZeroTurnYawIntegral()
+    sample(tracker)
+    value = sample(tracker, now=0.1)
+    assert sample(tracker, now=0.1) == value
+
+
+def test_direction_change_restarts_without_old_torque():
+    tracker = ExperimentalZeroTurnYawIntegral()
+    sample(tracker)
+    sample(tracker, now=0.1)
+    assert sample(tracker, now=0.2, target_yaw_rate_radps=-0.1) == 0.0
+    assert sample(tracker, now=0.3, target_yaw_rate_radps=-0.1) < 0.0
+
+
+@pytest.mark.parametrize("gain", (0.0, -1.0, 2.01, math.nan, math.inf, True, "bad"))
+def test_gain_configuration_is_bounded(gain):
+    with pytest.raises(ValueError):
+        ZeroTurnYawIntegralConfig(gain)
+
