+
+
+def test_stall_timeout_and_progress_release():
+    tracker=ExperimentalCrabYawHold()
+    for i in range(20):sample(tracker,now=i*.2,signed_speed_mps=0.)
+    with pytest.raises(ValueError,match="stalled"):
