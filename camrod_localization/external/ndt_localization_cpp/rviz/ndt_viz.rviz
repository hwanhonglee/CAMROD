Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 5
      Plane Cell Count: 40
      Color: 70; 70; 70
      Alpha: 0.4
    # NDT map (viz-only loader, voxel-downsampled once; latched)
    - Class: rviz_default_plugins/PointCloud2
      Name: NDT map (pcd)
      Enabled: true
      Topic:
        Value: /localization/ndt/viz/map_flat
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use rainbow: true
      Autocompute Value Bounds: false
      Min Value: -1
      Max Value: 6
      Alpha: 0.9
      Decay Time: 0
      Selectable: false
      Position Transformer: XYZ
    # lanelet2 map from camrod_map (/map/markers, latched)
    - Class: rviz_default_plugins/MarkerArray
      Name: Lanelet2 map (camrod_map)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /map/markers
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    # LiDAR scan placed with the NDT result (map frame): lies on the map when the match is right
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR scan (NDT aligned)
      Enabled: true
      Topic:
        Value: /localization/ndt/viz/scan_flat
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 1
      Decay Time: 0
      Selectable: false
      Position Transformer: XYZ
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: NDT pose
      Enabled: true
      Topic:
        Value: /localization/ndt/viz/pose_flat
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 40; 40
      Shaft Length: 1
      Shaft Radius: 0.05
      Head Length: 0.3
      Head Radius: 0.12
      Alpha: 1
      Covariance:
        Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: EKF pose (localization)
      Enabled: true
      Topic:
        Value: /localization/pose_with_covariance_ros
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 40; 120; 255
      Shaft Length: 1
      Shaft Radius: 0.05
      Head Length: 0.3
      Head Radius: 0.12
      Alpha: 1
      Covariance:
        Value: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.6
      Frames:
        All Enabled: false
        robot_center_link:
          Value: true
        ndt_lidar_link:
          Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 30
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Current View
      Target Frame: robot_center_link
      Distance: 25
      Pitch: 0.9
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
