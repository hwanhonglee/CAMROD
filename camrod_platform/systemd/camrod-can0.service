[Unit]
Description=CAMROD SocketCAN can0 setup
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=network.target

[Service]
Type=oneshot
# HH_260629 - Set can0 to 500 kbit/s with 100 ms restart before network startup.
ExecStart=/usr/local/sbin/camrod-setup-can0 can0 500000 100
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
