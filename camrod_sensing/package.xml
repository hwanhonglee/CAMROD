<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camrod_sensing</name>
  <version>0.0.0</version>
  <description>LiDAR/Camera preprocessing and velocity conversion for camping cart.</description>
  <maintainer email="hwanhong57@gmail.com">hong</maintainer>
  <!-- HH_260114 Set explicit Apache license. -->
  <license>Apache-2.0</license>
  <!-- HH_260109 New sensing package for LiDAR/Camera preprocessing and runtime sensor interfaces. -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>avg_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>opencv</depend>
  <depend>cuda_cudart</depend>
  <!-- HH_260528: rear camera publisher (camera_rear_publisher_node) -->
  <depend>cv_bridge</depend>
  <depend>yaml-cpp</depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all-dev</exec_depend>
  <!-- HJ_260529: optional LiDAR driver — declared so packages-up-to pulls it in automatically -->
  <exec_depend>vanjee_lidar_sdk</exec_depend>
  <exec_depend>vanjee_lidar_msg</exec_depend>
  <!-- HH_260611: ublox_gps is the only GNSS driver path; the old dGNSS fallback was removed. -->
  <exec_depend>ublox_gps</exec_depend>
  <exec_depend>ntrip_client</exec_depend>
  <exec_depend>ground_segmentation_ros2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- HH_260720 - Unit-test active-route obstacle cost clipping geometry. -->
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- HH_260722 - Unit-test GNSS launch routing without connected hardware. -->
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
